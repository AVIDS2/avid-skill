#!/usr/bin/env bash
# SessionStart hook for avid-skill plugin
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_avid_content=$(cat "${PLUGIN_ROOT}/skills/using-avid/SKILL.md" 2>&1 || echo "Error reading using-avid skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_avid_escaped=$(escape_for_json "$using_avid_content")
session_context="<IMPORTANT>\nYou have AVID skills loaded (avid-skill plugin).\n\n**Below is 'avid-skill:using-avid' — personal product-engineering defaults (advisory, scene-dependent). For other avid skills, use the Skill tool:**\n\n${using_avid_escaped}\n\nAVID defaults (prefer when they fit; skip/adapt with a one-line why when they don't):\n1. New product/vertical → consider product-bootstrap (research + P0), not theater on approved spikes.\n2. Self-building a capability → prefer research-before-build.\n3. Missing tool → prefer install-dont-reinvent over silent hand-roll.\n4. Agent runtime → agent-framework-choice by SCENE: web FE/BE ≠ default Pi SDK; local harness → Pi/pi-ai/embed Pi; durable workflow → LangGraph.\n5. Implementation → ponytail; Superpowers only on Claude Code when helpful.\nNever force an invalid stack/runtime just to \"comply\".\n</IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
